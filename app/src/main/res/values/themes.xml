<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Base.Theme.PatitasAlRescate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/marronPrimario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/marronClaro</item>
        <item name="colorOnPrimaryContainer">@color/marronOscuro</item>
        <item name="colorSecondary">@color/grisAcento</item>
        <item name="colorOnSecondary">@color/negro</item>
        <item name="android:statusBarColor">@color/marronOscuro</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/textoPrincipal</item>
        <item name="android:textColorSecondary">@color/textoSecundario</item>

        <!-- Configuración de Toolbar para modo claro -->
        <item name="toolbarStyle">@style/Widget.Patitas.Toolbar</item>
    </style>

    <style name="Widget.Patitas.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">@color/blanco</item>
    </style>

    <style name="Theme.PatitasAlRescate" parent="Base.Theme.PatitasAlRescate" />

    <style name="Theme.PatitasAlRescate.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.PatitasAlRescate.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>