<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Base.Theme.PatitasAlRescate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- El teclado redimensiona la pantalla para no tapar los campos de texto. -->
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="colorPrimary">@color/marronPrimario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/marronClaro</item>
        <item name="colorOnPrimaryContainer">@color/marronOscuro</item>
        <item name="colorSecondary">@color/grisAcento</item>
        <item name="colorOnSecondary">@color/negro</item>
        <item name="android:statusBarColor">@color/marronOscuro</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/textoPrincipal</item>
        <item name="android:textColorSecondary">@color/textoSecundario</item>
        <item name="android:editTextColor">@color/texto_busqueda</item>
        <item name="editTextColor">@color/texto_busqueda</item>
        <item name="android:textColorHint">@color/textoSecundario</item>

        <!-- Configuración de Toolbar para modo claro -->
        <item name="toolbarStyle">@style/Widget.Patitas.Toolbar</item>
    </style>

    <style name="Widget.Patitas.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">@color/blanco</item>
    </style>

    <style name="Theme.PatitasAlRescate" parent="Base.Theme.PatitasAlRescate" />

    <style name="Theme.PatitasAlRescate.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.PatitasAlRescate.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Pickers siempre en esquema claro: números oscuros sobre fondo blanco.
         Cada overlay hereda el tema propio del componente (trae sus estilos internos). -->
    <style name="ThemeOverlay.Patitas.CalendarLight" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">#795548</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D7CCC8</item>
        <item name="colorOnPrimaryContainer">#212121</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorOnSurface">#212121</item>
        <item name="colorOnSurfaceVariant">#5D4037</item>
        <item name="colorSecondaryContainer">#D7CCC8</item>
        <item name="colorOnSecondaryContainer">#212121</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#5D4037</item>
    </style>

    <style name="ThemeOverlay.Patitas.TimePickerLight" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">#795548</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D7CCC8</item>
        <item name="colorOnPrimaryContainer">#212121</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorSurfaceContainerHighest">#ECE6E2</item>
        <item name="colorOnSurface">#212121</item>
        <item name="colorOnSurfaceVariant">#5D4037</item>
        <item name="colorSecondaryContainer">#D7CCC8</item>
        <item name="colorOnSecondaryContainer">#212121</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#5D4037</item>
    </style>
</resources>
