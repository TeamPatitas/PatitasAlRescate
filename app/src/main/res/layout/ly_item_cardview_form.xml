<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    android:backgroundTint="@color/naranajBajo">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/img_icono_form"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:background="@drawable/bg_rounded_image"
            android:backgroundTint="#5D4037"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_nombre_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/texto_card_oscuro"
            tools:text="Formulario de Adopción General"
            app:layout_constraintStart_toEndOf="@id/img_icono_form"
            app:layout_constraintTop_toTopOf="@id/img_icono_form"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txt_fecha_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/texto_card_oscuro"
            tools:text="31, Oct 2026"
            app:layout_constraintStart_toStartOf="@id/txt_nombre_form"
            app:layout_constraintTop_toBottomOf="@id/txt_nombre_form"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_ver_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Ver formulario PDF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#5D4037"
            app:layout_constraintTop_toBottomOf="@id/img_icono_form"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
