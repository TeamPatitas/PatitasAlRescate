<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_publication_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    tools:context=".controllers.management.UserPublication">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarUserPublication"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_navegacion_claro"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Publicar una Mascota"
        app:titleTextColor="@color/blanco"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarUserPublication">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/naranajBajo"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Ilustración decorativa superior -->
                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:background="@drawable/bg_circulo_icono_claro"
                        android:contentDescription="Ilustración Patitas al Rescate"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/img_default_refugio" />

                    <!-- Encabezado decorativo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/chewy"
                        android:gravity="center"
                        android:text="🐾 ¡Juntos por los peluditos! 🐾"
                        android:textColor="@color/marronPrimario"
                        android:textSize="24sp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="3dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/naranja_asociacion" />

                    <!-- Texto principal solicitado -->
                    <TextView
                        android:id="@+id/txtMensajeUserPublication"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="Somos los desarrolladores de esta aplicación y te ayudaremos a publicar a las mascotas desde nuestra cuenta de albergue, a quien desee adoptarla le haremos comunicarte contigo mediante el numero que nos escribas. Gracias por preocuparte por los peluditos"
                        android:textColor="@color/texto_card_oscuro"
                        android:textSize="16sp" />

                    <!-- Recuadro decorativo de ayuda rápida -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🐶🐱"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Cuéntanos sobre la mascota (fotos, nombre, raza y tu número) para publicarla."
                            android:textColor="@color/textoPrincipal"
                            android:textSize="13sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <!-- Botón verde de WhatsApp -->
                    <Button
                        android:id="@+id/btnWhatsappDesarrolladores"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#25D366"
                        android:text="Contáctanos"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
