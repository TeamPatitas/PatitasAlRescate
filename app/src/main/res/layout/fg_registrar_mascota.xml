<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registrar_mascota_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_post_login"
    tools:context=".controllers.management.FragmentRegistrarMascota">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Datos de la mascota"
                android:textStyle="bold"
                android:textColor="@color/texto_titulo_sobre_crema"
                android:textSize="24sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="   Nombre de la mascota"
                app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                app:startIconTint="@color/textoPrincipal"
                app:hintTextColor="@color/textoSecundario"
                app:boxStrokeColor="@color/marronPrimario">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_reg_nombre_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:textColor="@color/textoPrincipal"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Especie"
                android:textStyle="bold"
                android:textColor="@color/textoPrincipal"
                android:gravity="center_vertical"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/marronPrimario"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinner_especie"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ly_otra_especie"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="   Escribe la especie"
                android:visibility="gone"
                app:hintTextColor="@color/textoSecundario"
                app:boxStrokeColor="@color/marronPrimario">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_otra_especie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:textColor="@color/textoPrincipal"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Raza"
                android:textStyle="bold"
                android:textColor="@color/textoPrincipal"
                android:gravity="center_vertical"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="8dp"
                android:drawableTint="@color/marronPrimario"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinner_raza"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ly_otra_raza"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="   Escribe la raza"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_otra_raza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Sexo"
                android:textStyle="bold"
                android:textColor="@color/textoPrincipal"
                android:gravity="center_vertical"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="8dp"
                android:drawableTint="@color/marronPrimario"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinner_sexo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Edad (API pendiente)"
                android:visibility="gone"
                app:startIconDrawable="@android:drawable/ic_menu_day"
                app:startIconTint="@color/textoPrincipal"
                app:hintTextColor="@color/textoSecundario"
                app:boxStrokeColor="@color/marronPrimario">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_reg_edad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:textColor="@color/textoPrincipal"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="   Temperamento (ej. Juguetón)"
                app:startIconDrawable="@android:drawable/ic_menu_info_details"
                app:startIconTint="@color/textoPrincipal"
                app:hintTextColor="@color/textoSecundario"
                app:boxStrokeColor="@color/marronPrimario">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_reg_temperamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:textColor="@color/textoPrincipal"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="   Historia de rescate"
                app:startIconDrawable="@android:drawable/ic_menu_edit"
                app:startIconTint="@color/textoPrincipal"
                app:hintTextColor="@color/textoSecundario"
                app:boxStrokeColor="@color/marronPrimario">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_reg_historia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:textColor="@color/textoPrincipal"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Fotos (máx. 3, jpeg/png/webp)"
                android:textStyle="bold"
                android:textColor="@color/textoPrincipal"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca un recuadro para elegir esa foto. Mantén presionado para quitarla. Se suben al registrar, una por índice (1, 2, 3)."
                android:textColor="@color/textoSecundario"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/layout_fotos_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <ImageView
                    android:id="@+id/foto_slot_0"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_rounded"
                    android:contentDescription="Foto 1 (índice 1)"
                    android:padding="28dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera" />

                <ImageView
                    android:id="@+id/foto_slot_1"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_rounded"
                    android:contentDescription="Foto 2 (índice 2)"
                    android:padding="28dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera" />

                <ImageView
                    android:id="@+id/foto_slot_2"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_rounded"
                    android:contentDescription="Foto 3 (índice 3)"
                    android:padding="28dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_disponible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:checked="true"
                android:text="Disponible para adopción"
                android:textColor="@color/textoPrincipal"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_guardar_mascota"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="#FF9800"
                android:text="REGISTRAR MASCOTA"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:cornerRadius="30dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
