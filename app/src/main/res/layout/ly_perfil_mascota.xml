<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perfilmascota"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEBE9">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPerfilMascota"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_navegacion_claro"
        app:title="Detalles de la Mascota"
        app:titleTextColor="@color/blanco"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_detalle_mascota"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#D7CCC8"
        android:contentDescription="Foto de la mascota"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/toolbarPerfilMascota"
        tools:src="@android:drawable/ic_menu_gallery" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/ly_botones_accion"
        app:layout_constraintTop_toBottomOf="@id/img_detalle_mascota">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="#5D4037"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txt_edit_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:enabled="false"
                android:hint="Nombre"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:minHeight="48dp"
                android:padding="8dp"
                android:textColor="#3E2723"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Especie"
                        android:textColor="#5D4037"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txt_edit_especie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="Perro"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textColor="#5D4037" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raza"
                        android:textColor="#5D4037"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txt_edit_raza"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="único"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textColor="#5D4037" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sexo"
                        android:textColor="#5D4037"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txt_edit_sexo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="Macho/Hembra"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textColor="#5D4037" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Temperamento"
                android:textColor="#5D4037"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txt_edit_temperamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:enabled="false"
                android:hint="Alegre, Juguetón..."
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="48dp"
                android:padding="8dp"
                android:textColor="#5D4037" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Historia / Descripción"
                android:textColor="#5D4037"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txt_edit_historia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:enabled="false"
                android:hint="Historia..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="48dp"
                android:minLines="3"
                android:padding="8dp"
                android:textColor="#4E342E" />

            <LinearLayout
                android:id="@+id/layout_fotos_mascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fotos (máx. 3)"
                    android:textColor="#5D4037"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toca un recuadro para cambiar esa foto (índices 1, 2, 3). Se suben al guardar."
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <ImageView
                        android:id="@+id/foto_mascota_slot_0"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="#D7CCC8"
                        android:contentDescription="Foto 1 (índice 1)"
                        android:padding="24dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_camera" />

                    <ImageView
                        android:id="@+id/foto_mascota_slot_1"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="#D7CCC8"
                        android:contentDescription="Foto 2 (índice 2)"
                        android:padding="24dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_camera" />

                    <ImageView
                        android:id="@+id/foto_mascota_slot_2"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="#D7CCC8"
                        android:contentDescription="Foto 3 (índice 3)"
                        android:padding="24dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ly_botones_accion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_favorito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#FCE4EC"
            android:minHeight="48dp"
            android:text="❤ AGREGAR A FAVORITOS"
            android:textColor="#D81B60"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_accion_principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#5D4037"
            android:minHeight="48dp"
            android:text="CARGANDO..."
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>