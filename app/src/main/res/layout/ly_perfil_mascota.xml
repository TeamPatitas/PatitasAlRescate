<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perfilmascota"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPerfilMascota"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_navegacion_claro"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Detalles de la Mascota"
        app:titleTextColor="@color/blanco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/ly_botones_accion"
        app:layout_constraintTop_toBottomOf="@id/toolbarPerfilMascota">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Imagen principal o carrusel con bordes redondeados dentro de contenedor -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/img_detalle_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D7CCC8"
                    android:contentDescription="Foto de la mascota"
                    android:scaleType="centerCrop"
                    tools:src="@android:drawable/ic_menu_gallery" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewpager_fotos_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_indicador_fotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="#80000000"
                    android:elevation="4dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/blanco"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="1/3" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- Nombre destacado -->
                <EditText
                    android:id="@+id/txt_edit_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:enabled="false"
                    android:hint="Nombre de la mascota"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords|textMultiLine"
                    android:singleLine="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:scrollHorizontally="false"
                    android:minHeight="48dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/texto_titulo_sobre_crema"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Pelusa" />

                <!-- Fila de 3 tarjetas de atributos: Especie, Raza, Sexo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/naranajBajo"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ESPECIE"
                                android:textColor="@color/marronPrimario"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/txt_edit_especie"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:gravity="center"
                                android:hint="Perro"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:minHeight="36dp"
                                android:padding="4dp"
                                android:textColor="@color/texto_card_oscuro"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Gato" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/naranajBajo"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RAZA"
                                android:textColor="@color/marronPrimario"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/txt_edit_raza"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:gravity="center"
                                android:hint="Mestizo"
                                android:importantForAutofill="no"
                                android:inputType="textCapWords|textMultiLine"
                                android:singleLine="false"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:scrollHorizontally="false"
                                android:minHeight="36dp"
                                android:padding="4dp"
                                android:textColor="@color/texto_card_oscuro"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Persa" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/naranajBajo"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SEXO"
                                android:textColor="@color/marronPrimario"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/txt_edit_sexo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:gravity="center"
                                android:hint="Macho/Hembra"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:minHeight="36dp"
                                android:padding="4dp"
                                android:textColor="@color/texto_card_oscuro"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Femenino" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Tarjeta de Temperamento -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/naranajBajo"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temperamento"
                            android:textColor="@color/marronPrimario"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/txt_edit_temperamento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@android:color/transparent"
                            android:enabled="false"
                            android:hint="Alegre, Juguetón..."
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:minHeight="40dp"
                            android:padding="4dp"
                            android:textColor="@color/texto_card_oscuro"
                            android:textSize="15sp"
                            tools:text="Cariñosa y tranquila" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tarjeta de Historia / Descripción -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/naranajBajo"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Historia / Descripción"
                            android:textColor="@color/marronPrimario"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/txt_edit_historia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@android:color/transparent"
                            android:enabled="false"
                            android:gravity="top"
                            android:hint="Historia..."
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine"
                            android:lineSpacingExtra="4dp"
                            android:minHeight="48dp"
                            android:minLines="3"
                            android:padding="4dp"
                            android:textColor="@color/texto_card_oscuro"
                            android:textSize="15sp"
                            tools:text="Fue rescatada hace unos meses y busca una familia amorosa." />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tarjeta de Requiere Formulario (visible en modo adoptante) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_requiere_formulario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/naranajBajo"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Requiere formulario"
                            android:textColor="@color/marronPrimario"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_requiere_formulario_adoptante"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sí, esta mascota requiere llenar un formulario de adopción"
                            android:textColor="@color/texto_card_oscuro"
                            android:textSize="15sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Aviso cuando no está disponible para adopción -->
                <TextView
                    android:id="@+id/txt_aviso_no_adoptable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Esta mascota no está disponible para adopción pero puedes leer su historia"
                    android:textColor="@color/textoPrincipal"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Opciones exclusivas de modo refugio -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_disponible_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="Visible"
                    android:textColor="@color/textoPrincipal"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_adoptable_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="Disponible para adopción"
                    android:textColor="@color/textoPrincipal"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_requiere_formulario_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="Requiere formulario"
                    android:textColor="@color/textoPrincipal"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layout_selector_formulario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_rounded"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Formulario asociado (obligatorio)"
                        android:textColor="@color/marronPrimario"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_formulario_mascota"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_disponible_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/textoPrincipal"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Visible: Sí"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txt_adoptable_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/textoPrincipal"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Disponible para adopción: No" />

                <TextView
                    android:id="@+id/txt_requiere_formulario_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/textoPrincipal"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Requiere formulario: Sí" />

                <LinearLayout
                    android:id="@+id/layout_fotos_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fotos (máx. 3)"
                        android:textColor="@color/textoPrincipal"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Toca un recuadro para cambiar esa foto (índices 1, 2, 3). Se suben al guardar."
                        android:textColor="@color/textoSecundario"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <ImageView
                            android:id="@+id/foto_mascota_slot_0"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_image"
                            android:clipToOutline="true"
                            android:contentDescription="Foto 1 (índice 1)"
                            android:padding="24dp"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_camera" />

                        <ImageView
                            android:id="@+id/foto_mascota_slot_1"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_image"
                            android:clipToOutline="true"
                            android:contentDescription="Foto 2 (índice 2)"
                            android:padding="24dp"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_camera" />

                        <ImageView
                            android:id="@+id/foto_mascota_slot_2"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_image"
                            android:clipToOutline="true"
                            android:contentDescription="Foto 3 (índice 3)"
                            android:padding="24dp"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_camera" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ly_botones_accion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_crema"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_favorito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#FCE4EC"
            android:minHeight="48dp"
            android:text="❤ AGREGAR A FAVORITOS"
            android:textColor="#D81B60"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_accion_principal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#5D4037"
            android:text="CARGANDO..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
