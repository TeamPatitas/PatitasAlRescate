<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perfil_refugio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema">

    <!-- Toolbar Superior -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPerfilRefugio"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_navegacion_claro"
        app:titleTextColor="@color/blanco"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Detalles del Refugio"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipePerfilRefugio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarPerfilRefugio"
        app:layout_constraintBottom_toTopOf="@id/ly_botones_refugio">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Tarjeta Hero de Foto de Portada del Refugio -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/naranajBajo">

                <ImageView
                    android:id="@+id/img_foto_refugio_perfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D7CCC8"
                    android:contentDescription="Foto del refugio"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_default_refugio"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp">

                <!-- Encabezado: Nombre del Refugio y Estado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/txt_nombre_refugio_perfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nombre del Refugio"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_titulo_sobre_crema"
                        android:textColorHint="@color/textoSecundario"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords|textMultiLine"
                        android:singleLine="false"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:scrollHorizontally="false"/>

                    <TextView
                        android:id="@+id/txt_indicador_mi_refugio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="TU REFUGIO"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/blanco"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/naranja_asociacion"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </LinearLayout>

                <!-- Switch Mostrar Dirección (Sección de Administración del Refugio) -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_mostrar_direccion_refugio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Mostrar dirección"
                    android:textColor="@color/texto_titulo_sobre_crema"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Botón de Mapa (Redirecciona a Latitud y Longitud) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_mapa_refugio"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="Ver ubicación en el mapa"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/blanco"
                    android:backgroundTint="@color/verde_persona"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_dialog_map"
                    app:iconTint="@color/blanco"
                    app:iconGravity="textStart"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <!-- Tarjeta de Contacto -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:backgroundTint="@color/naranajBajo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contacto (WhatsApp)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/marronPrimario"/>

                        <EditText
                            android:id="@+id/txt_contacto_refugio_perfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Contacto"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/verde_persona"
                            android:textColorHint="@color/textoSecundario"
                            android:background="@android:color/transparent"
                            android:enabled="false"
                            android:importantForAutofill="no"
                            android:inputType="phone"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Sección de Eventos -->
                <TextView
                    android:id="@+id/txt_titulo_eventos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Próximos Eventos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_titulo_sobre_crema"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_eventos_refugio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"/>

                <TextView
                    android:id="@+id/txt_no_eventos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_input_rounded"
                    android:text="No hay eventos programados por el momento."
                    android:textAlignment="center"
                    android:textColor="@color/textoPrincipal"
                    android:textStyle="italic"
                    android:visibility="gone"/>

                <!-- Sección de Donaciones y QR -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    android:backgroundTint="@color/naranajBajo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/txt_titulo_donaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apoya nuestra causa"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/naranja_asociacion"/>

                        <TextView
                            android:id="@+id/txt_desc_donaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Puedes donar escaneando nuestro código QR (Yape / Plin) o contactándonos directamente."
                            android:textAlignment="center"
                            android:textSize="14sp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/texto_card_oscuro"/>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_qr_donacion"
                            android:layout_width="220dp"
                            android:layout_height="220dp"
                            android:layout_marginTop="16dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="@color/blanco">

                            <ImageView
                                android:id="@+id/img_qr_donacion"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:scaleType="fitCenter"
                                android:src="@android:drawable/ic_menu_gallery"/>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Barra Inferior de Acciones (Modo Refugio) -->
    <LinearLayout
        android:id="@+id/ly_botones_refugio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:background="@color/fondo_crema"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_editar_refugio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="EDITAR REFUGIO"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/blanco"
            android:backgroundTint="@color/naranja_asociacion"
            app:cornerRadius="26dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCambiarModoAdoptante"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="MODO ADOPTANTE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blanco"
                android:backgroundTint="@color/verde_persona"
                app:cornerRadius="24dp"/>

            <Button
                android:id="@+id/btnCerrarSesionRefugio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="CERRAR SESIÓN"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blanco"
                android:backgroundTint="#D32F2F"
                app:cornerRadius="24dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
