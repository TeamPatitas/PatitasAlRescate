<?xml version="1.0" encoding="utf-8"?>
<!--
    ly_formulario_adopcion.xml
    Formulario completo de adopción con soporte de Modo Oscuro via colores ?attr/.
    Estructura: Toolbar + NestedScrollView con las 5 secciones del PDF.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ly_formulario_adopcion_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- ================================================================
         TOOLBAR
    ================================================================ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_formulario"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Formulario de Adopción"
            app:titleTextColor="?attr/colorOnPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ================================================================
         CONTENIDO SCROLLABLE
    ================================================================ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ════════════════════════════════════════════════════════
                 SECCIÓN 1: DATOS PERSONALES
            ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="1. Datos Personales del Adoptante"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Apellidos y Nombres -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Apellidos y Nombres *"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_apellidos_nombres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Teléfono Fijo -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Teléfono"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_telefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Fecha -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Fecha"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_fecha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="date" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DNI — validación estricta: exactamente 8 dígitos -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_dni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="DNI * (8 dígitos)"
                        app:counterEnabled="true"
                        app:counterMaxLength="8"
                        app:errorEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_dni"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Dirección -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Dirección"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_direccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPostalAddress|textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- E-mail -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="E-mail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Celular — validación estricta: exactamente 9 dígitos -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_celular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Celular * (9 dígitos)"
                        app:counterEnabled="true"
                        app:counterMaxLength="9"
                        app:errorEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_celular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="phone"
                            android:maxLength="9" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Estado Civil -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Estado Civil"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_estado_civil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ciudad -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Ciudad"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_ciudad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Referencia Personal -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp"
                        android:text="Referencia Personal"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Nombre"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_ref_nombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:hint="Teléfono"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_ref_telefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 SECCIÓN 2: PREGUNTAS SÍ / NO
            ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="2. Cuestionario Sí / No"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Helper que genera cada bloque de RadioGroup Sí/No -->

                    <!-- P1: ¿Tiene otros animalitos? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_tiene_animales" />
                    <!-- La etiqueta se asigna en Java: ver ActividadFormularioAdopcion -->

                    <!-- P2: ¿Están esterilizados? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_esterilizados" />

                    <!-- P3: ¿Ha tenido otros antes? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_tuvo_antes" />

                    <!-- P4: ¿Acuerdo en visita periódica? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_visita_periodica" />

                    <!-- P5: ¿Todos de acuerdo en adoptar? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_todos_acuerdo" />

                    <!-- P6: ¿Hay niños? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_hay_ninos" />

                    <!-- P7: ¿Alérgicos / Asma? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_alergicos" />

                    <!-- P8: ¿Arrendadores permiten? (3 opciones: Sí / No / Casa Propia) -->
                    <TextView
                        android:id="@+id/lbl_arrendador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="4dp"
                        android:text="¿Los arrendadores permiten mascotas?"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <RadioGroup
                        android:id="@+id/rg_arrendador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_arrendador_si"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sí"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/rb_arrendador_no"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/rb_arrendador_casa_propia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Casa propia"
                            android:textColor="?attr/colorOnSurface" />
                    </RadioGroup>

                    <!-- P9: ¿Espacio suficiente? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_espacio_suficiente" />

                    <!-- P10: ¿Veterinario de cabecera? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_veterinario" />

                    <!-- P11: ¿Recursos para gastos? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_recursos" />

                    <!-- P12: ¿Compromiso de esterilizar? -->
                    <include layout="@layout/item_pregunta_si_no"
                        android:id="@+id/pregunta_esterilizar" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 SECCIÓN 3: PREGUNTAS ABIERTAS
            ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="3. Preguntas Abiertas"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Q1: ¿Por qué desea adoptar? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="¿Por qué desea adoptar?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_por_que_adoptar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q2: ¿Cuáles animales tiene? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="¿Cuáles animales tiene actualmente?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_cuales_animales"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q3: ¿Qué pasó con los anteriores? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="¿Qué pasó con los animales anteriores?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_que_paso_anteriores"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q4: ¿Edades de los niños? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Edades de los niños (si los hay)"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_edades_ninos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q5: ¿Mudanza, qué pasaría? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="En caso de mudanza, ¿qué pasaría con el animal?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_mudanza"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q6: ¿Ruptura familiar? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="En caso de ruptura familiar, ¿qué cambios habría?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_ruptura_familiar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q7: ¿Cuántos años vive un perro? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="¿Cuántos años vive un perro/gato en promedio?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_anios_vida"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q8: Visión en 5 años -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="¿Cómo te imaginas en 5 años con el animal?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_vision_5_anios"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q9: ¿Dónde dormirá? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="¿Dónde dormirá el animal?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_donde_dormira"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q10: ¿Cuánto tiempo solo? — Spinner con rangos -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="¿Cuántas horas al día pasará solo?"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinner_horas_solo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_spinner_outlined"
                        android:padding="8dp" />

                    <!-- Q11: ¿Medidas comportamiento no deseado? -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="¿Qué medidas tomaría ante comportamiento no deseado?"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_comportamiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Q12: Nombre y teléfono del veterinario -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:hint="Nombre y teléfono de su veterinario (si tiene)"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_veterinario_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 SECCIÓN 4: GASTOS Y CUIDADOS
            ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="4. Gastos y Cuidados"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Spinner: Rango de gastos mensuales -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Gastos mensuales estimados (S/.):"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinner_gastos"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_outlined"
                        android:padding="8dp" />

                    <!-- CheckBoxes: Cuidados -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Cuidados que dará al animal (seleccione todos los que aplique):"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cb_visitas_vet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Visitas al veterinario"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_vacunacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vacunación"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_paseos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Paseos con correa"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_collar_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Collar de identificación"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_desparasitacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Desparasitación"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_cepillado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cepillado"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_arenero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Arenero"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_croquetas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Croquetas"
                        android:textColor="?attr/colorOnSurface" />

                    <CheckBox
                        android:id="@+id/cb_agua_limpia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Agua limpia disponible"
                        android:textColor="?attr/colorOnSurface" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 SECCIÓN 5: COMPROMISOS Y FIRMA
            ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="5. Compromisos y Firma"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- CheckBox: Acepto Condiciones (OBLIGATORIO) -->
                    <CheckBox
                        android:id="@+id/cb_acepto_condiciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="ACEPTO CONDICIONES *\nMe comprometo a cuidar al animal con responsabilidad, amor y brindarle las condiciones necesarias para su bienestar."
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                    <!-- Divisor -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="?attr/colorOutline" />

                    <!-- Firma mediante Foto (OPCIONAL) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Firma manuscrita (Opcional)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Adjunta una foto de tu firma manuscrita desde tu galería. El formulario puede enviarse sin esta foto."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <!-- Botón adjuntar foto -->
                    <Button
                        android:id="@+id/btn_adjuntar_firma"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:drawableStart="@android:drawable/ic_menu_camera"
                        android:drawablePadding="8dp"
                        android:text="📷  Adjuntar foto de firma"
                        android:textColor="?attr/colorPrimary" />

                    <!-- Previsualización de firma -->
                    <ImageView
                        android:id="@+id/img_preview_firma"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginBottom="4dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:contentDescription="Vista previa de la firma"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txt_estado_firma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Sin firma adjuntada (opcional)"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 BOTÓN: GENERAR Y ENVIAR
            ════════════════════════════════════════════════════════ -->
            <Button
                android:id="@+id/btn_generar_enviar_pdf"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="📄  GENERAR Y ENVIAR POR WHATSAPP"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
