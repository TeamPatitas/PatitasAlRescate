  "paths": {
    "/admin/health": {
      "get": {
        "tags": [
          "Administración"
        ],
        "description": "Verifica el estado de la api y sus dependencias, es piola pa saber que c cayó xd",
        "operationId": "HealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "x-roles-policy": "DevOnly",
        "x-cooldown-policy": "HealthCheckCooldown",
        "x-cooldown": "30 segundos"
      }
    },
    "/admin/user": {
      "get": {
        "tags": [
          "Administración"
        ],
        "description": "Obtiene la información del usuario actual, necesita que el usuario haya iniciado sesión.",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "x-roles-policy": "User"
      },
      "patch": {
        "tags": [
          "Administración"
        ],
        "description": "Actualiza la información del usuario, necesita que el usuario haya iniciado sesión, pero si tienes rol dev puedes modificar cualquier cosa a cualquiera xd.",
        "operationId": "UpdateCurrentUser",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
