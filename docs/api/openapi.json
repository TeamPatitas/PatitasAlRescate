    "/admin/shelter/enable/{id}": {
      "patch": {
        "tags": [
          "Administración"
        ],
        "description": "Habilita un shelter con el ID especificado, hace que el refugio aparezca para todos los usuarios y luego asigna el rol ShelterOwner a todos los dueños del refugio.",
        "operationId": "EnableShelter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShelterResponse"
                }
              }
            }
          }
        },
        "x-roles-policy": "DevOnly",
        "x-cooldown-policy": "ShelterSwitchAviabilityCooldown",
        "x-cooldown": "5 minutos"
      }
    },
    "/admin/shelter/disable/{id}": {
      "patch": {
        "tags": [
          "Administración"
        ],
        "description": "Deshabilita un shelter con el ID especificado, hace que el refugio no aparezca para los usuarios y luego remueve el rol ShelterOwner de todos los dueños del refugio.",
        "operationId": "DisableShelter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
