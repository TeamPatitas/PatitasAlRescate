  "components": {
    "schemas": {
      "AuthResponse": {
        "required": [
          "roles",
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePetRequest": {
        "required": [
          "breed",
          "gender",
          "name",
          "species",
          "story",
          "temperament"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "species": {
            "$ref": "#/components/schemas/Species"
          },
          "breed": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "temperament": {
            "type": "string",
            "nullable": true
          },
          "story": {
            "type": "string",
            "nullable": true
          },
          "available": {
            "type": "boolean",
            "nullable": true
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateShelterRequest": {
        "required": [
          "address",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "photo": {
            "type": "string",
            "format": "binary",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Gender": {
        "enum": [
          "MALE",
          "FEMALE"
        ],
        "type": "string"
      },
      "HealthResponse": {
        "required": [
          "services",
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthServiceResult"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HealthServiceResult": {
        "required": [
          "latencyMs",
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          },
          "latencyMs": {
            "type": "number",
            "format": "double"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PetResponse": {
        "required": [
          "available",
          "breed",
          "gender",
          "id",
          "name",
          "photos",
          "shelterId",
          "specie",
          "story",
          "temperament"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "specie": {
            "$ref": "#/components/schemas/Species"
          },
          "breed": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
